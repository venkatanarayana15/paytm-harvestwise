# HarvestWise — Environment Variables Template
# Copy to .env and fill in your actual values. Never commit .env.

# ─── Sarvam AI (Indic Speech) ─────────────────────────────────────────────
# Free tier: https://www.sarvam.ai/pricing
SARVAM_API_KEY=your_sarvam_api_key_here

# ─── Cognee (Causal Memory) ───────────────────────────────────────────────
# https://docs.cogn.ai/quickstart
COGNEE_BASE_URL=https://tenant-XXX.cogn.ai
COGNEE_API_KEY=your_cogn_api_key_here

# ─── n8n (Workflow Automation) ─────────────────────────────────────────────
# Cloud webhook URL (created when you set up a webhook node)
N8N_WEBHOOK_URL=https://n8n.your-domain.webhook/harvestwise-dispatch

# ─── Twilio (WhatsApp Dispatch) ────────────────────────────────────────────
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# WhatsApp template setup (register in Twilio console)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+919999999999
TWILIO_CONTENT_SID=Hxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TEMPLATE_VARS=4

# ─── Optional: External APIs ──────────────────────────────────────────────
# Weather API (Open-Meteo doesn't require a key)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Mandi price feeds (add your source)
MANDI_PRICE_URL=

# ─── Optional: Local Testing ───────────────────────────────────────────────
# API server (already in main.py)
API_HOST=127.0.0.1
API_PORT=8000
