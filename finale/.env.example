# HarvestWise — Environment Variables Template
# Copy to .env and fill in your actual values. Never commit .env.
#   cp finale/.env.example finale/.env

# ─── Sarvam AI (Indic Speech + LLM) ───────────────────────────────────────
# Free tier: https://indus.sarvam.ai  (STT saaras:v3 · TTS bulbul:v3 · LLM chat)
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM model selection (verified live 2026-09-18):
#   sarvam-105b-conversations = FAST chat model, ~1-2s, used for the live loop
#   sarvam-105b               = REASONING model, ~55s with 8k tokens, opt-in only
# Do not point the fast path at the reasoning model: it emits reasoning_content
# first and consumed the whole token budget before producing any JSON.
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_LLM_DEEP_MODEL=sarvam-105b

# LLM_MODE: hybrid (default, LLM assists + rules stay authoritative) | off
# LLM_TIMEOUT: hard wall-clock budget for the fast model (default 8s)
# LLM_DEEP_TIMEOUT / LLM_DEEP_MAX_TOKENS: the reasoning model needs a large
# token budget (8000 works; 4000 returns finish_reason=length with no content)
LLM_MODE=hybrid
LLM_TIMEOUT=8
LLM_DEEP_TIMEOUT=75
LLM_DEEP_MAX_TOKENS=8000

# ─── Weather ──────────────────────────────────────────────────────────────
# seeded (default) = the 78% constant, so the ₹546 demo story holds on ANY day.
# live            = real Open-Meteo forecast for Basavanagudi (needs no API key);
#                   numbers will move, so the narration must follow the screen.
WEATHER_MODE=seeded

# ─── Demo determinism ─────────────────────────────────────────────────────
# 1 (default) = inventory resets to the seeded baseline on every server start,
#               so a rehearsal is repeatable. Set 0 to keep stock across restarts.
DEMO_RESET_ON_START=1

# ─── Cognee (causal memory) ───────────────────────────────────────────────
# https://docs.cogn.ai/quickstart
COGNEE_BASE_URL=https://tenant-XXX.aws.cognee.ai
COGNEE_API_KEY=your_cogn_api_key_here
COGNEE_DATASET=harvestwise
# A real recall measured 12.3s — the old 10s client timeout made every recall
# fail. Keep this comfortably above observed latency.
COGNEE_TIMEOUT=60

# ─── n8n (workflow automation) ────────────────────────────────────────────
# The webhook the API POSTs each dispatched order to (Dispatch workflow).
N8N_WEBHOOK_URL=https://n8n.your-domain.webhook/harvestwise-dispatch
N8N_MCP_URL=
N8N_MCP_TOKEN=

# ─── Twilio (WhatsApp dispatch) ───────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# REQUIRED for a real send. Without it the API SKIPS the send and labels it
# (it no longer posts to a placeholder number, which produced Twilio 572002
# while looking like a successful dispatch). Trial accounts must add this
# number as a verified recipient in the Twilio console.
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
# Content templates registered in the Twilio console.
TWILIO_CONTENT_SID=Hxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ORDER_CONTENT_SID=Hxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_BRIEFING_CONTENT_SID=Hxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2 = the registered 2-variable template; 4 adds supplier + total.
TWILIO_TEMPLATE_VARS=2

# ─── Optional: External APIs ──────────────────────────────────────────────
# Open-Meteo needs no key (used by engine/restock.py and n8n/briefing.json).
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Mandi price feeds (add your source)
MANDI_PRICE_URL=

# ─── Optional: Local Testing ──────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
